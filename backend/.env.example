# Copy to .env. Leave the key blank for the complete local demo flow.
# Never commit backend/.env or paste a real key into this example file.
OPENAI_API_KEY=
# Current cost-efficient model; change deliberately if your account supports another model.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=2000
# Live OpenAI calls remain disabled until this is positive. 25 = $0.25.
OPENAI_MONTHLY_BUDGET_CENTS=0
OPENAI_MONTHLY_REQUEST_LIMIT=20
# Keep these prices aligned with the selected model's official current pricing.
OPENAI_INPUT_USD_PER_MILLION_TOKENS=0.20
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=1.20
DATABASE_URL=sqlite:///./career_assistant.db
# Maximum accepted PDF/DOCX size in bytes (default: 5 MiB).
MAX_UPLOAD_BYTES=5242880
# Comma-separated browser origins allowed to call the API (production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
